# Copy to .env and adjust. Real environment variables override this file.

# HTTP listener (the frontend expects http://localhost:5090).
HOST=localhost
PORT=5090

# Set when running behind a reverse proxy (IIS/ARR, nginx): true, a hop count,
# or e.g. "loopback".
TRUST_PROXY=

# Shared "Solution" MySQL 8+ database (the same one admin-backend uses). The
# database and its tables are created on startup if missing.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Solution
DB_CONNECTION_LIMIT=10
# Alternatively one URL, which overrides the DB_* values above:
# DATABASE_URL=mysql://user:password@localhost:3306/Solution

JWT_KEY=change-me-to-a-long-random-secret
JWT_ISSUER=UserBackend
JWT_AUDIENCE=UserFrontend
JWT_EXPIRES_HOURS=12

# Comma-separated front-end origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The admin backend hosts the wallet hub; NOTIFY_SECRET must equal its own.
ADMIN_BACKEND_URL=http://localhost:5100
NOTIFY_SECRET=change-me

FORTUNEGATE_BASE_URL=https://agentapi.fortunegate.net
FORTUNEGATE_TOKEN=
FORTUNEGATE_LANG=1
FORTUNEGATE_RETURN_URL=http://localhost:5173/slot
FORTUNEGATE_DEFAULT_WIN_RATIO=0
# FortuneGate sends this in the "Callback-Token" header of seamless callbacks.
FORTUNEGATE_CALLBACK_TOKEN=
