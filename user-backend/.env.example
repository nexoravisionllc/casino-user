# Copy to .env and adjust. Real environment variables override this file.

# HTTP listener (the frontend expects http://localhost:5090).
HOST=localhost
PORT=5090

# Set when running behind a reverse proxy (IIS/ARR, nginx): true, a hop count,
# or e.g. "loopback".
TRUST_PROXY=

# Shared "Solution" MySQL 8+ database (the same one admin-backend uses). The
# database and its tables are created on startup if missing.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Solution
DB_CONNECTION_LIMIT=10
# Alternatively one URL, which overrides the DB_* values above:
# DATABASE_URL=mysql://user:password@localhost:3306/Solution

JWT_KEY=change-me-to-a-long-random-secret
JWT_ISSUER=UserBackend
JWT_AUDIENCE=UserFrontend
JWT_EXPIRES_HOURS=12

# Comma-separated front-end origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The admin backend hosts the wallet hub; NOTIFY_SECRET must equal its own.
ADMIN_BACKEND_URL=http://localhost:5100
NOTIFY_SECRET=change-me

FORTUNEGATE_BASE_URL=https://agentapi.fortunegate.net
FORTUNEGATE_TOKEN=
FORTUNEGATE_LANG=1
FORTUNEGATE_RETURN_URL=http://localhost:5173/slot
FORTUNEGATE_DEFAULT_WIN_RATIO=0
# FortuneGate sends this in the "Callback-Token" header of seamless callbacks.
FORTUNEGATE_CALLBACK_TOKEN=

# ---------------------------------------------------------------------------
# Self-hosted crypto gateway (BSC + Ethereum). When ONCHAIN_MNEMONIC,
# ONCHAIN_HOT_WALLET_KEY and at least one *_RPC_URL are set, it handles crypto
# deposits and withdrawals. See ../CRYPTO-GATEWAY.md.
# ---------------------------------------------------------------------------
# BIP-39 phrase: player deposit addresses are m/44'/60'/0'/0/<n>. Whoever has it
# controls every deposit address. Generate it offline and back it up on paper.
ONCHAIN_MNEMONIC=
# 0x private key of the hot wallet: pays withdrawals and sweep gas. Keep only a
# working float in it (stablecoins + some BNB/ETH for gas).
ONCHAIN_HOT_WALLET_KEY=
# Treasury that deposits are swept to (ideally a hardware wallet or multisig).
# Empty: the hot wallet.
ONCHAIN_SWEEP_TO=
# false on all but one instance if you run several user-backend processes.
ONCHAIN_WORKER=true
ONCHAIN_POLL_SECONDS=20
ONCHAIN_WATCH_HOURS=72
ONCHAIN_FULL_SCAN_MINUTES=60
ONCHAIN_MIN_DEPOSIT_USD=5
ONCHAIN_PRICE_MAX_AGE_SECONDS=10800

# BNB Smart Chain. Use a paid RPC (QuickNode, Alchemy, Ankr, NodeReal...) in production.
BSC_RPC_URL=
BSC_CHAIN_ID=56
BSC_CONFIRMATIONS=15
BSC_TOKENS=USDT:0x55d398326f99059fF775485246999027B3197955,USDC:0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d
# Chainlink BNB/USD. Empty disables BNB deposits and withdrawals.
BSC_PRICE_FEED=0x0567F2323251f0Aab15c8dFb1967E4e8A7D42aeE
BSC_SWEEP_MIN_USD=10

# Ethereum mainnet.
ETH_RPC_URL=
ETH_CHAIN_ID=1
ETH_CONFIRMATIONS=12
ETH_TOKENS=USDT:0xdAC17F958D2ee523a2206206994597C13D831ec7,USDC:0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
# Chainlink ETH/USD. Empty disables ETH deposits and withdrawals.
ETH_PRICE_FEED=0x5f4eC3Df9cbd43714FE2740f5E3616155c5b8419
# Ethereum gas is expensive: each USDT sweep costs a few dollars, so batch more.
ETH_SWEEP_MIN_USD=200

# Demo/showcase mode. true: the deposit page shows N/A instead of a real address,
# player withdrawals are disabled, new sign-ups are approved at once with
# DEV_SIGNUP_CREDIT, and agent accounts in the admin panel are read-only (the
# top admin keeps full access). Set it in admin-backend/.env too. false: normal.
DEV_MODE=false
# Starting balance (USD) for each new sign-up while DEV_MODE=true.
DEV_SIGNUP_CREDIT=200
